# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun. ".env" asla commit edilmemelidir.

# AI soru üretimi ve cevap değerlendirmesi için gerekli
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# En az 32 karakterlik rastgele bir değer (production'da zorunlu)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

PORT=3001
FRONTEND_URL=http://localhost:5173

# İsteğe bağlı: SQLite dosya yolu (varsayılan: backend/database.sqlite)
# DB_PATH=./data/database.sqlite
