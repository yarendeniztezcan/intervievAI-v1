{
  "name": "interview-prep-frontend",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "AI Destekli Mülakat Hazırlık Platformu - Frontend",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:mobile": "vite build --mode mobile && cap sync && node scripts/patch-native.cjs",
    "mobile:icons": "npx @capacitor/assets generate --iconBackgroundColor \"#2563eb\" --splashBackgroundColor \"#2563eb\"",
    "android": "node scripts/patch-native.cjs && cap open android",
    "ios": "node scripts/patch-native.cjs && cap open ios"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@monaco-editor/react": "^4.7.0",
    "axios": "^1.20.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
