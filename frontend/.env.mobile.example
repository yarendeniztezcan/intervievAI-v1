# Mobil derleme için (npm run build:mobile). Dosyayı ".env.mobile" olarak kopyalayın.
# Telefonun backend'e ulaşacağı adres. "localhost" TELEFONDA TELEFONUN KENDİSİDİR, bilgisayarınız değil!
#   Gerçek telefon (aynı Wi-Fi):  http://BILGISAYARIN_YEREL_IP_ADRESI:3001   (ör. http://192.168.1.25:3001)
#   Android emülatörü:            http://10.0.2.2:3001
#   iOS simülatörü:               http://localhost:3001
#   Yayın (production):           https://api.siteniz.com   (HTTPS zorunlu önerilir)
VITE_API_URL=http://192.168.1.25:3001
